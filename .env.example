# Copy this file to .env and fill in the values from your Auth0 application.
# .env is gitignored. Never commit real credentials.

# Auth0 application settings (Applications -> your app -> Settings)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Must be listed under "Allowed Callback URLs" in the Auth0 dashboard.
AUTH0_CALLBACK_URL=http://localhost:3000/callback

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when NODE_ENV=production.
SESSION_SECRET=

# Public origin of this app. Used as the returnTo target after Auth0 logout,
# so it must be listed under "Allowed Logout URLs" in the Auth0 dashboard.
APP_BASE_URL=http://localhost:3000

PORT=3000

# PKCE is on by default. Set to false only if your Auth0 tenant rejects it.
# ENABLE_PKCE=false
